// PostgreSQL Online Database - Cloud backup / sync
// Mirrors qform data for online access
generator client {
  provider = "prisma-client-js"
  output   = "../../src/prisma/generated/online"
}

datasource db {
  provider = "postgresql"
  url      = env("ONLINE_DATABASE_URL")
}

model Submission {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String
  companyName         String?
  phone               String
  productType         String
  fabricType          String?
  createdAt           DateTime @default(now())
  fileUrls            String[]
  additionalNeeds     String?
  embroideryPositions String?
  printPoints         String?
  sizeDetails         Json?
  specs               String?
  totalQuantity       String?
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Wso {
  id              Int      @id @default(autoincrement())
  name            String
  email           String
  companyName     String?
  phone           String
  lineId          String?
  productType     String
  fabricType      String
  specs           String?
  sizeDetails     Json
  totalQuantity   Int
  printTitle      String?
  printSize       String?
  embroideryTitle String?
  embroiderySize  String?
  additionalNeeds String?
  images          Json?
  createdAt       DateTime @default(now())

  @@map("wso")
}
