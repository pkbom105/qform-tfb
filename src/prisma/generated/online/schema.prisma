// PostgreSQL — Primary storage for qform
generator client {
  provider = "prisma-client-js"
  output   = "../../src/prisma/generated/online"
}

datasource db {
  provider = "postgresql"
  url      = env("ONLINE_DATABASE_URL")
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  companyName String?
  phone       String
  lineId      String?
  totalOrders Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id                  Int      @id @default(autoincrement())
  customerId          Int
  customer            Customer @relation(fields: [customerId], references: [id])
  // Product info
  productType         String
  fabricType          String
  specs               String?
  // Size & quantity
  sizeData            String   @default("{}")
  totalQuantity       Int      @default(0)
  manualTotal         String?
  // Decoration sets (JSON array string)
  decorationSets      String   @default("[]")
  // Printing details
  printTitle          String?
  printSize           String?
  printPos2Title      String?
  printPos2Size       String?
  printPos3Title      String?
  printPos3Size       String?
  printPos4Title      String?
  printPos4Size       String?
  printPos5Title      String?
  printPos5Size       String?
  // Embroidery details
  embroideryTitle     String?
  embroiderySize      String?
  embroideryPos2Title String?
  embroideryPos2Size  String?
  embroideryPos3Title String?
  embroideryPos3Size  String?
  embroideryPos4Title String?
  embroideryPos4Size  String?
  embroideryPos5Title String?
  embroideryPos5Size  String?
  // Additional
  additionalNeeds     String?
  images              String   @default("[]")
  reportName          String?
  status              String   @default("pending")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("orders")
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("settings")
}
