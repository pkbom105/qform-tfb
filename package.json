{
  "name": "qform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate --schema=prisma/local/schema.prisma && prisma generate --schema=prisma/online/schema.prisma",
    "db:generate:local": "prisma generate --schema=prisma/local/schema.prisma",
    "db:generate:online": "prisma generate --schema=prisma/online/schema.prisma",
    "db:migrate:local": "prisma migrate dev --schema=prisma/local/schema.prisma",
    "db:push:local": "prisma db push --schema=prisma/local/schema.prisma",
    "db:push:online": "prisma db push --schema=prisma/online/schema.prisma",
    "db:studio:local": "prisma studio --schema=prisma/local/schema.prisma",
    "db:studio:online": "prisma studio --schema=prisma/online/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}