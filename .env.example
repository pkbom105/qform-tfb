# ============================================
# Local Database (SQLite) - Primary storage
# ============================================
LOCAL_DATABASE_URL="file:./dev.db"

# ============================================
# Online Database (PostgreSQL) - Cloud backup
# ============================================
# Set these environment variables before running:
#   export DB_USER=your_db_user
#   export DB_PASSWORD=your_db_password
#   export DB_HOST=your_db_host
ONLINE_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/qform2026?schema=public&sslmode=disable

# ============================================
# PostgreSQL container credentials (for db service)
# These are read automatically from env vars or .env
# ============================================
DB_USER=qform.admin
DB_PASSWORD=your_password_here