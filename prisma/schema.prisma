generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String
  companyName         String?
  phone               String
  productType         String
  fabricType          String?
  createdAt           DateTime @default(now())
  fileUrls            String[]
  additionalNeeds     String?
  embroideryPositions String?
  printPoints         String?
  sizeDetails         Json?
  specs               String?
  totalQuantity       String?
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}
model Quotation {
  id               Int      @id @default(autoincrement())
  name             String
  email            String
  companyName      String?
  phone            String
  lineId           String?  // เพิ่มอันนี้
  productType      String
  fabricType       String
  specs            String?
  sizeDetails      Json     // เก็บเป็น JSON สำหรับ 12 ไซซ์
  totalQuantity    Int
  printTitle       String?  // เพิ่มอันนี้
  printSize        String?  // เพิ่มอันนี้
  embroideryTitle  String?  // เพิ่มอันนี้
  embroiderySize   String?  // เพิ่มอันนี้
  additionalNeeds  String?
  images           Json?
  createdAt        DateTime @default(now())
}
