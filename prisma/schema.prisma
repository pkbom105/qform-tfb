// Shared schema - DO NOT MODIFY directly
// Uses datasource blocks that get overridden by --schema flag
// This is the base schema template

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String
  companyName         String?
  phone               String
  productType         String
  fabricType          String?
  createdAt           DateTime @default(now())
  fileUrls            String[]
  additionalNeeds     String?
  embroideryPositions String?
  printPoints         String?
  sizeDetails         Json?
  specs               String?
  totalQuantity       String?
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Wso {
  id               Int      @id @default(autoincrement())
  name             String
  email            String
  companyName      String?
  phone            String
  lineId           String?
  productType      String
  fabricType       String
  specs            String?
  sizeDetails      Json
  totalQuantity    Int
  printTitle       String?
  printSize        String?
  embroideryTitle  String?
  embroiderySize   String?
  additionalNeeds  String?
  images           Json?
  createdAt        DateTime @default(now())

  @@map("wso")
}